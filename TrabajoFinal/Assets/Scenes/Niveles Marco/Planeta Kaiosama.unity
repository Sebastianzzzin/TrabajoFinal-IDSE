  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 781321e6676d79843b3aaaf4129721ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelNegroNarrativo: {fileID: 491991055}
  velocidadFade: 1
  nombreKaio: Kaio-Sama
  caraKaio: {fileID: 284383237, guid: 298479d53534d394fa197edee01cd83c, type: 3}
  dialogoIntro:
  - "Goku, escucha bien. La contaminaci\xF3n de la Tierra ha llegado hasta aqu\xED."
  - "Mi planeta se est\xE1 volviendo inestable y la gravedad est\xE1 loca.."
  - "Sobrevive 1 minuto sin chocarte mientras lo estabilizo. \xA1No te quedes quieto"
  dialogoFinal:
  - "\xA1Uff! Eso estuvo cerca. Has manejado bien la gravedad."
  - Pero no hay tiempo para descansar. Siento un Ki maligno en el Infierno.
  - "Janemba est\xE1 alterando la realidad. \xA1Ve y detenlo!"
  survivalManager: {fileID: 2101235636}
  nombreEscenaInfierno: Janemba
