  m_Name: 
  m_EditorClassIdentifier: 
  panelNegroNarrativo: {fileID: 1159558140}
  velocidadFade: 1
  nombreNarrador: Paikuhan
  caraPaikuhan: {fileID: -1567571412, guid: 271317ca21e217f40aa0048a6c1b9dfa, type: 3}
  dialogoIntro:
  - "\xA1Goku! La energ\xEDa maligna de Janemba est\xE1 distorsionando la realidad
    del Infierno."
  - "Esas columnas de luz morada que ves brotar del suelo son pura inestabilidad
    dimensional. \xA1No dejes que te toquen!"
  - "Debes llegar a la C\xFApula Celeste al final del camino. Es el \xFAnico lugar
    seguro para contener esta locura."
  dialogoFinal:
  - "\xA1Lo lograste! Al entrar en la C\xFApula has estabilizado el sector."
  - Eres impresionante, Goku. Janemba ha retrocedido por ahora...
  - Regresemos al Torneo del Otro Mundo, creo que nos hemos ganado un gran banquete.
  escenaSiguiente: Menu Principal
