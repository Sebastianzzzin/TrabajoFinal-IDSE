--- !u!114 &1780027579
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1780027578}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b1de41768753d74b87924864196caef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JanembaDirector
  panelNegroNarrativo: {fileID: 70248732}
  velocidadFade: 1
  nombreNarrador: Piccolo
  caraPaikuhan: {fileID: 21300000, guid: 22460797c90b67244b6977c276b70fdc, type: 3}
  dialogoIntro:
  - '"Goku, no hay tiempo que perder. Debes volar hasta la cima de la Torre de Kamisama
    lo antes posible"'
  - "\"Pero ten mucho cuidado. Tao Pai Pai ha regresado e intentar\xE1 derribarte
    lanzando sus enormes pilares de troncos\""
  - '"Usa tus reflejos para esquivar cada tronco y no detengas tu vuelo por nada
    del mundo."'
  dialogoFinal:
  - "\"Hmp, nada mal, Goku. Lograste superar la defensa de Tao Pai Pai con \xE9xito.
    Ahora no nos distraigamos, \xA1sigamos buscando las Esferas del Drag\xF3n restantes
    antes de que sea tarde!\""
  escenaSiguiente: "CiudadDa\xF1ada"
